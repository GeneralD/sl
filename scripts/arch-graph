#!/bin/zsh
# scripts/arch-graph [--check] — render the SPM target graph into
# docs/ARCHITECTURE.md; --check diffs instead of writing (gate step).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
export DEVELOPER_DIR=/Library/Developer/CommandLineTools

json=$(swift package dump-package 2>/dev/null) || { echo "arch-graph: dump-package failed" >&2; exit 1; }

render() {
/usr/bin/python3 - "$json" <<'PY'
import json, sys
pkg = json.loads(sys.argv[1])
targets = {t["name"]: t for t in pkg.get("targets", [])}
lines = []
lines.append("# Architecture")
lines.append("")
lines.append("Generated by `scripts/arch-graph` — do not edit by hand.")
lines.append("")
lines.append("## Targets")
lines.append("")
lines.append("| Target | Kind | Depends on |")
lines.append("|---|---|---|")
for name in sorted(targets):
    t = targets[name]
    deps = ", ".join(
        d.get("byName", [None])[0] if isinstance(d.get("byName"), list) else str(d)
        for d in t.get("dependencies", [])
    ) or "—"
    lines.append(f"| `{name}` | {t.get('type','?')} | {deps} |")
lines.append("")
lines.append("## Dependency graph")
lines.append("")
lines.append("```mermaid")
lines.append("graph TD")
for name in sorted(targets):
    for d in targets[name].get("dependencies", []):
        dep = d.get("byName", [None])[0] if isinstance(d.get("byName"), list) else str(d)
        if dep in targets:
            lines.append(f"    {name} --> {dep}")
lines.append("```")
sys.stdout.write("\n".join(lines).rstrip() + "\n")
PY
}

if [ "${1:-}" = "--check" ]; then
    tmp=$(/usr/bin/mktemp)
    render > "$tmp"
    if /usr/bin/diff -q "$tmp" docs/ARCHITECTURE.md >/dev/null 2>&1; then
        /bin/rm -f "$tmp"
        echo "ARCHITECTURE.md up to date"
    else
        /usr/bin/diff docs/ARCHITECTURE.md "$tmp" | head -20
        /bin/rm -f "$tmp"
        exit 1
    fi
else
    mkdir -p docs
    render > docs/ARCHITECTURE.md
    echo "wrote docs/ARCHITECTURE.md"
fi
